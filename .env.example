# Makefile берёт RUN_MODE, чтобы выбрать docker-compose.$RUN_MODE.yml: dev или prod
RUN_MODE=dev

# Порты на хосте, открыты только на 127.0.0.1: оболочка (api) и редактор (office)
API_PORT=8020
OFFICE_PORT=8021

UID=1000
GID=1000

# Папка книги на хосте: главы — папки в её корне
BOOK_DIR=./deploy/book

# Язык интерфейса: ru (по умолчанию) или en. Проще задать при сборке:
# make init language=en
# APP__LANGUAGE=en

# Плагины — папки в этой папке, как расширения VS Code. Ставят их в панели
# «Расширения» или кладут папку сюда
PLUGINS_DIR=./plugins

# Шрифты для office: каких в нём нет, api скачивает сюда из Google Fonts, а office
# ставит их сам. Свои .ttf и .otf тоже можно положить сюда
FONTS_DIR=./deploy/fonts

# Библиотека — папка, внутри которой лежат книги-источники, абсолютный путь. Главы
# ссылаются на книги, не копируя их; api видит эту папку только на чтение. Пусто —
# домашняя папка
LIBRARY_DIR=

# Общий секрет api и office: им подписан конфиг редактора и запросы office к api.
# Обязателен, сгенерировать: openssl rand -hex 32
OFFICE__JWT_SECRET=
